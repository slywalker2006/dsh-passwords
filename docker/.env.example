# dsh-passwords 容器专用环境变量模板（可选进阶配置）：普通安装只需一条
# docker run -d -e DEEPSEEK_API_KEY=... -e SETUP_KEY=... -p 127.0.0.1:3088:3088 ...，
# 无需本文件；SETUP_KEY 会在首次初始化时写入卷内 .env 并保持不变。
# 需要自定义端口/域名/SSH 端点/第三方端点登记等高级项时，再 cp docker/.env.example
# docker/.env 后填写，用 docker run --env-file docker/.env 或 docker compose --env-file
# docker/.env 传入；命令行 -e 的优先级高于 --env-file。
# 不要用仓库根的 .env.example（宿主机模板）：它会注入占位 SETUP_KEY、宿主库路径，
# 并让 MCP_GATEWAY_AUTO_TLS 留空（自动 HTTPS，容器内会去绑 443），导致容器不监听/启动失败。
# 完整变量清单见仓库根 .env.example；进阶覆盖项见 ../docs/advanced-tuning.md。
# dsh 的模型密钥（必填）：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 对外公开主机名（可选）：登录链接等对外地址用它拼接；留空则按请求头推断
MCP_GATEWAY_PUBLIC_HOST=

# ── 密钥（可选）：留空则从 SETUP_KEY 派生 ──
# 会话签名密钥；生产建议 openssl rand -hex 32 独立设置
#MCP_JWT_SECRET=
# 网关内部管理接口密钥（dsh 插件 → 网关）
#MCP_INTERNAL_SECRET=

# ── 上游 dsh（可选）：镜像默认为容器内回环，一般无需改 ──
#MCP_GATEWAY_UPSTREAM=http://127.0.0.1:3080
# 上游为 HTTPS/WSS 时校验证书；留空=校验，0=关闭（仅调试，勿用于生产）
#MCP_GATEWAY_UPSTREAM_TLS_VERIFY=

# Third-party endpoint registry (comma-separated): `[owner:][ws:|http:]path`.
# `owner:` is owner-only; every other rule needs BOTH the owner's registration and the
# subuser's SSH toggle, and is not split by HTTP method. A trailing /* matches direct
# child paths only. Full syntax, transports, and hot reload: ../docs/endpoint-registration.md
MCP_GATEWAY_SSH_ENDPOINTS=

# ── 管理员目录选择器安全起点（可选进阶项）──
# 逗号/换行分隔的容器内绝对路径；留空时唯一安全起点为容器用户家目录（os.homedir()）。
# 全盘根（/ 或盘符根）会丢弃，不会从整机根枚举；需与挂载卷路径一致。
# 注意：compose 需在 environment 显式透传该键，或改用 docker run --env-file。
#MCP_GATEWAY_DIRECTORY_PICKER_ROOTS=

# ── 网关超时与 inventory 缓存（可选进阶项）──
# 严格十进制整数；未设置/空白用默认，非法值回退默认并告警。范围见 ../docs/advanced-tuning.md
#MCP_GATEWAY_INTERNAL_PROBE_TIMEOUT_MS=  # 内部探测超时；默认 10000
#MCP_GATEWAY_UPSTREAM_HEADER_TIMEOUT_MS= # 上游响应头超时；默认 60000
#MCP_DSH_PASSWORDS_INVENTORY_TTL_MS=     # inventory 缓存 TTL；默认 0（不缓存）

# Remote mux 大消息传输调优（可选，毫秒/字节）；空值/未设置回退应用默认。
# 严格十进制整数；非法值告警并回退默认。改值需重建容器（docker compose up -d --force-recreate）。
#MCP_GATEWAY_MUX_FRAGMENT_BYTES=      # 分片字节；默认 131072，合法 0 或 16384..1048576（0=单帧）
#MCP_GATEWAY_MUX_PING_INTERVAL_MS=    # 保活间隔；默认 2000，合法 250..60000
#MCP_GATEWAY_MUX_PONG_TIMEOUT_MS=     # Pong 时限；默认 30000，合法 2000..600000
#MCP_GATEWAY_MUX_WRITE_STALL_MS=      # 写停滞时限；默认 30000，合法 5000..600000

# ── 软件自更新（可选进阶项）：默认关闭/手动 ──
# 本模板不挂载宿主 Docker socket，也未提供宿主机 Compose 目录，应用内更新按 fail-closed
# 只显示宿主机手动命令（docker compose pull && docker compose up -d）。需要应用内更新时，
# 显式挂载 socket 与 Compose 目录后再填写；Docker socket 等同授予容器宿主控制权限，仅在可信部署启用。
#MCP_DSH_AUTO_UPDATE=                # 部署级自动更新总开关；留空=开，0/false/no=关
#MCP_DSH_UPDATE_MAX_BPS=             # 自动下载限速（字节/秒）；只能调低，默认 1MiB/s
#MCP_DSH_DOCKER_SELF_UPDATE=1        # 开启 Docker 应用内更新；默认关
#MCP_DSH_DOCKER_COMPOSE_DIR=         # 宿主机 Compose 目录（容器内绝对路径）
#MCP_DSH_DOCKER_COMPOSE_FILE=        # Compose 文件名（相对该目录，不含 ..）
#MCP_DSH_DOCKER_IMAGE=               # 目标镜像仓库，如 owner/dsh-passwords
#MCP_DSH_DOCKER_SOCKET=              # Docker socket 路径；留空=/var/run/docker.sock

# Bundled DSH version (optional; defaults to the release baseline)
#DSH_VERSION=0.2.1-alpha.2
