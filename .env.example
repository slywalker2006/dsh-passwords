# ──────────────────────────────────────────────
# dsh-passwords 配置文件（复制为 .env 后生效）
# 一键安装（install.sh）会自动生成含随机 SETUP_KEY 的 .env，
# 手动安装才需要看这个文件。
# ──────────────────────────────────────────────

# 首次配置密钥（必填）：install.sh 自动生成；手动安装用 openssl rand -hex 24 生成。
# 作用：第一次打开网页创建主用户时校验用；JWT 会话密钥也由它派生，安装后不要改。
SETUP_KEY=change-me-to-a-strong-random-key

# 会话签名密钥（强烈建议生产环境独立设置，与 SETUP_KEY 解耦）：
# 留空则从 SETUP_KEY 派生；一旦泄漏 SETUP_KEY，攻击者就能伪造任意用户会话。
# 用 openssl rand -hex 32 生成；设置后不要随意更换（旧会话会全部失效）。
MCP_JWT_SECRET=

# 网关内部管理接口密钥（dsh 插件通知网关用）；留空则从 SETUP_KEY 派生，与 JWT 域分离。
# 用 openssl rand -hex 32 生成；设置后不要随意更换。
MCP_INTERNAL_SECRET=

# ── 数据库 ──────────────────────────────────
# SQLite 数据库文件（自动建库，无需安装 MySQL）
MCP_DB_PATH=./data/platform.db
# 数据静态加密密钥（可选）：openssl rand -hex 32 生成。
# 留空则从 SETUP_KEY 派生；一旦设置就不能再换，否则旧数据无法解密。
MCP_DB_ENC_KEY=

# ── 网关监听 ────────────────────────────────
MCP_GATEWAY_HOST=0.0.0.0
# 网关端口：留空自动判断——自动 HTTPS 用 443（需 root 绑定），HTTP 模式用 8080。
# 不要写死 443：写死后 HTTP 模式会沿用，且会覆盖 Docker 镜像默认的 3088。
#MCP_GATEWAY_PORT=443
# dsh 网页地址（插件自动指向 dsh 实际端口，一般不用改）
MCP_GATEWAY_UPSTREAM=http://127.0.0.1:3080
# 上游 dsh 为 HTTPS/WSS 时校验其证书；留空=校验，0=关闭（仅调试，勿用于生产）
MCP_GATEWAY_UPSTREAM_TLS_VERIFY=

# ── 第三方端点登记表（登记即授权；未登记路径对子用户一律拒绝）──
# 语法（逗号分隔）：`[owner:][ws:|http:]路径`，前缀可省略、顺序任意；路径精确匹配，
# 或末尾 /* 只匹配直接子路径。owner: 仅主用户；其余规则需「主用户已登记」+
# 「子用户已勾选 SSH 权限」两条同时满足，且不按方法细分。详见 docs/endpoint-registration.md
MCP_GATEWAY_SSH_ENDPOINTS=

# ── 管理员目录选择器安全起点（可选进阶项）──
# 逗号或换行分隔的绝对路径：主用户/管理员在前端「可创建目录根」选择器里只能浏览这些
# 子树，防止从 Linux / 或 Windows 盘符根枚举整机。留空时唯一安全起点为当前用户家目录
# （os.homedir()）。全盘根与相对路径会被丢弃。
#MCP_GATEWAY_DIRECTORY_PICKER_ROOTS=

# ── Remote mux 大消息传输调优（可选，毫秒/字节）──────────
# 严格十进制整数；未设置/空白用默认，非法值回退默认并告警。
# 分片字节数：默认 131072；合法 0 或 16384..1048576（0=关闭分片，单帧发送路径）
#MCP_GATEWAY_MUX_FRAGMENT_BYTES=
# 保活探测间隔：默认 2000；合法 250..60000
#MCP_GATEWAY_MUX_PING_INTERVAL_MS=
# Pong 匹配时限：默认 30000；合法 2000..600000
#MCP_GATEWAY_MUX_PONG_TIMEOUT_MS=
# 写停滞时限：默认 30000；合法 5000..600000
#MCP_GATEWAY_MUX_WRITE_STALL_MS=

# ── 网关超时与 inventory 缓存（可选进阶项，普通安装无需配置）──
# 严格十进制整数；未设置/空白用默认，非法值回退默认并告警。详见 docs/advanced-tuning.md
# 内部探测超时（ms）：默认 10000；合法 1000..600000
#MCP_GATEWAY_INTERNAL_PROBE_TIMEOUT_MS=
# 上游响应头超时（ms）：默认 60000；合法 1..600000
#MCP_GATEWAY_UPSTREAM_HEADER_TIMEOUT_MS=
# inventory 缓存 TTL（ms）：默认 0（不缓存）；合法 0..600000
#MCP_DSH_PASSWORDS_INVENTORY_TTL_MS=

# 80 端口：ACME 证书验证 + 301 跳转 HTTPS；留空自动（自动 HTTPS 开 80，HTTP 模式不监听）
#MCP_GATEWAY_REDIRECT_PORT=80
# 公网访问地址（跳转固定用它，防 Host 反射）；留空自动判断
MCP_GATEWAY_PUBLIC_HOST=

# ── 自动 HTTPS（Let's Encrypt，零配置） ─────
# 自己的域名（A 记录指向本机后填这里）；留空自动用 <公网IP>.sslip.io
MCP_GATEWAY_DOMAIN=
# 自动 HTTPS 开关：留空=自动开启；0=false=关闭（明文 HTTP，危险）
MCP_GATEWAY_AUTO_TLS=
# 证书到期提醒邮箱（可选）
MCP_GATEWAY_ACME_EMAIL=
# 1=使用 LE 测试环境签发（仅调试用，浏览器不信任）
MCP_GATEWAY_ACME_STAGING=

# ── 自备证书（可选，两个都填时优先于自动 HTTPS） ──
MCP_GATEWAY_TLS_CERT=
MCP_GATEWAY_TLS_KEY=

# ── dsh 相关 ────────────────────────────────
# dsh 安装目录（@deepseek-ai/dsh 所在处）；留空自动探测（npm root -g）
MCP_DSH_ROOT=
# 重载补丁后自动重启的 dsh systemd 服务名；留空按平台默认（Linux 用 dsh-web，Windows 不自动重启）
#MCP_DSH_RESTART_SERVICE=dsh-web
# dsh 设置文件路径（网关与 dsh 不在同一台机器时才需要）
MCP_DSH_SETTINGS_FILE=
# 手动指定 .env 路径（插件自动传，一般不用填）
DSH_PASSWORDS_ENV_FILE=
